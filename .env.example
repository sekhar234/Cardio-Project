# Required
OPENAI_API_KEY=
TAVILY_API_KEY=
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
QDRANT_URL=https://<cluster>.cloud.qdrant.io
QDRANT_API_KEY=
# Postgres (defaults to local SQLite when unset)
DATABASE_URL=
# Optional: require a code to start runs / ask questions on the public URL
ACCESS_CODE=
# Optional tuning
RESEARCH_MODEL=gpt-5-mini
CHECKER_MODEL=gpt-4.1
GRAPH_MODEL=gpt-5-mini
GRAPH_SMALL_MODEL=gpt-4.1-nano
MAX_QUERIES_PER_ROUND=16
MAX_SOURCES_PER_ROUND=18
MAX_RESEARCH_ROUNDS=2
